# ⚠️ EXAMPLE Environment Variables - DO NOT USE IN PRODUCTION!
# 
# TO USE:
# 1. Copy this file to: .env (for local development)
# 2. Copy this file to: .env.production (for reference only)
# 3. Replace all placeholder values with your ACTUAL keys
# 4. NEVER commit .env or .env.production to GitHub!
#
# For production deployment:
# - Add these variables in Railway's dashboard (Variables tab)
# - The .env files are in .gitignore and will NOT be pushed

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/threadlms
# OR for MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/threadlms?retryWrites=true&w=majority
# Get from: https://www.mongodb.com/cloud/atlas

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️ NEVER use 'your_super_secret_jwt_key_change_this_in_production' in production!
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
# Production example: https://your-app.netlify.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Cloudinary Configuration
# Get from: https://console.cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Newsletter Configuration
# Resend API - Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
# Use Resend's default domain or your verified domain
NEWSLETTER_FROM_EMAIL=onboarding@resend.dev
NEWSLETTER_FROM_NAME=ThreadLMS Newsletter

# Gemini API - Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# RSS2JSON API (optional) - Get from: https://rss2json.com
RSS2JSON_API_KEY=

