# Production Environment Variables for Frontend
# 
# ⚠️ IMPORTANT: This is just an EXAMPLE file!
# 
# TO USE:
# 1. Copy this file and rename to: .env.production
# 2. Replace all placeholder values with your ACTUAL keys
# 3. NEVER commit .env.production to GitHub!
#
# The .env.production file is in .gitignore and will NOT be pushed to GitHub
# You'll add these values directly in Netlify's dashboard

# Backend API URL (Get this from Railway after deploying backend)
# Example: https://threadlms-backend-production-xxxx.up.railway.app/api
VITE_API_URL=https://your-backend-url.railway.app/api

# Gemini API Key for AI features
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
